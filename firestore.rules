rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Reglas Firestore — Salón de Estudio Colaborativo
// ═══════════════════════════════════════════════════════════════════════════
//
// MODELO DE SEGURIDAD
// ───────────────────
// El backend (Express + Firebase Admin) bypasea estas reglas: realiza
// validación de negocio (unicidad de username, profanidad, membresía,
// formato, etc.) y escribe vía Admin SDK. Por lo tanto el cliente NUNCA
// debería necesitar escribir directamente en Firestore.
//
// Estas reglas son la RED DE SEGURIDAD frente a clientes maliciosos que
// intenten saltarse el backend hablando con Firestore mediante el SDK del
// cliente. La filosofía es:
//
//   • Lectura mínima necesaria.
//   • Escritura solo al titular del dato.
//   • Campos inmutables blindados.
//   • Subcolecciones cerradas a escritura desde el cliente.
//
// Cualquier colección no listada explícitamente queda denegada por la
// regla catch-all del final.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────────────
    function isAuthed() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function incoming() {
      return request.resource.data;
    }
    function isParticipantOf(roomId) {
      // Lee el doc de la sala UNA vez. Si la sala no existe → false.
      let room = get(/databases/$(database)/documents/rooms/$(roomId));
      return isAuthed()
             && room != null
             && (
                  room.data.ownerId == uid()
                  || uid() in room.data.participants
                );
    }

    // ─────────────────────────────────────────────────────────────────────
    // users/{uid} — Perfil del usuario.
    // ─────────────────────────────────────────────────────────────────────
    match /users/{userId} {

      // Solo el dueño puede LEER su propio perfil completo desde el cliente.
      // Otros usuarios obtienen el perfil público via GET /api/users/:uid
      // (Admin SDK) que aplica un whitelist (uid, username, avatar, displayName).
      allow read: if isAuthed() && uid() == userId;

      // Solo el dueño puede CREAR su propio documento. Validaciones
      // mínimas para evitar perfiles malformados desde el cliente.
      allow create: if isAuthed()
                    && uid() == userId
                    && incoming().uid == userId
                    && incoming().keys().hasAll([
                         'uid', 'username', 'fullName', 'email',
                         'avatar', 'provider', 'createdAt', 'online'
                       ])
                    && incoming().provider in ['password', 'google']
                    && incoming().username is string
                    && incoming().username.size() >= 4
                    && incoming().username.size() <= 10
                    && incoming().fullName is string
                    && incoming().fullName.size() >= 3;

      // Solo el dueño puede ACTUALIZAR. Campos inmutables blindados.
      allow update: if isAuthed()
                    && uid() == userId
                    && incoming().uid == resource.data.uid
                    && incoming().email == resource.data.email
                    && incoming().provider == resource.data.provider
                    && incoming().createdAt == resource.data.createdAt;

      // Solo el dueño puede ELIMINAR su perfil. En la práctica lo hace el
      // backend con Admin SDK, pero queda disponible si se migra al cliente.
      allow delete: if isAuthed() && uid() == userId;
    }

    // ─────────────────────────────────────────────────────────────────────
    // rooms/{roomId} — Sala de estudio.
    // ─────────────────────────────────────────────────────────────────────
    match /rooms/{roomId} {

      // Lectura: cualquier usuario autenticado puede ver una sala (necesario
      // para unirse por código compartido / link).
      allow read: if isAuthed();

      // Creación: el ownerId del doc debe coincidir con el uid del token.
      // Validaciones de forma mínimas.
      allow create: if isAuthed()
                    && incoming().ownerId == uid()
                    && incoming().roomId is string
                    && incoming().roomId == roomId
                    && incoming().accessCode is string
                    && incoming().name is string
                    && incoming().name.size() > 0
                    && incoming().name.size() <= 100
                    && incoming().participants is list
                    && uid() in incoming().participants;

      // Actualización: solo el dueño puede modificar la sala desde el cliente.
      // Las membresías (`participants`) las gestiona el backend con Admin SDK,
      // por lo que aquí bloqueamos cualquier escritura directa de no-dueños.
      // Campos inmutables blindados.
      allow update: if isAuthed()
                    && resource.data.ownerId == uid()
                    && incoming().roomId == resource.data.roomId
                    && incoming().ownerId == resource.data.ownerId
                    && incoming().createdAt == resource.data.createdAt;

      // Eliminación: solo el dueño.
      allow delete: if isAuthed() && resource.data.ownerId == uid();

      // ─── messages/{messageId} ──────────────────────────────────────────
      // Persistencia del chat. La escritura desde el cliente queda
      // siempre cerrada — los mensajes los guarda el backend dentro del
      // handler `send_message` tras verificar membresía y sanitizar.
      match /messages/{messageId} {
        // Lectura: solo participantes de la sala (incluye al dueño).
        allow read: if isParticipantOf(roomId);
        // Escritura/modificación/borrado: prohibido al cliente. El backend
        // (Admin SDK) lo hace; el cascade delete vive en deleteRoom.
        allow write: if false;
      }
    }

    // ─────────────────────────────────────────────────────────────────────
    // Catch-all: cualquier otra ruta queda totalmente denegada al cliente.
    // ─────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
