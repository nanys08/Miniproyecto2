PORT=3000
NODE_ENV=development

# Firebase Client Config
FIREBASE_API_KEY=your_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (Service Account)
# Opción A: Ruta al archivo JSON de service account
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Opción B: Variables individuales del service account
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# CORS
# Una sola URL, o varias separadas por coma (sin espacios necesarios):
#   CORS_ORIGIN=http://localhost:5173
#   CORS_ORIGIN=http://localhost:5173,https://miniproyecto2.vercel.app
CORS_ORIGIN=http://localhost:5173
