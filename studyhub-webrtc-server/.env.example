# Puerto del Signaling Server (Repositorio 3). Render lo asigna solo en prod;
# en local usamos 8082 (3000 = room-service, 8081 = chat-service).
PORT=8082
NODE_ENV=development

# Orígenes permitidos para CORS (frontend). Una URL o varias separadas por coma.
#   CORS_ORIGIN=http://localhost:5173
#   CORS_ORIGIN=http://localhost:5173,https://studyhub.vercel.app
CORS_ORIGIN=http://localhost:5173
