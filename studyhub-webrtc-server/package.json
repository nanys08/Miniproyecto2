{
  "name": "studyhub-webrtc-server",
  "version": "1.0.0",
  "description": "Signaling Server WebRTC (Repositorio 3) — reenvía offer/answer/ICE para videollamadas, llamadas y compartir pantalla de StudyHub. Servicio independiente del room-service y del chat-service.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "postinstall": "npm run build",
    "test:probe": "node tests/signaling.probe.cjs"
  },
  "keywords": [
    "webrtc",
    "signaling",
    "socket.io",
    "videollamada",
    "screen-share"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.3",
    "ts-node": "^10.9.2"
  }
}
