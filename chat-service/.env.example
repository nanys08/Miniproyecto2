# Puerto del servidor WebSocket (Repositorio 2). El ejemplo del profesor usa 8081.
PORT=8081
NODE_ENV=development

# Path del endpoint WebSocket (Tarea 2). El frontend conecta con
#   io(url, { path: "/ws/chat", auth: { ticket } })
WS_PATH=/ws/chat

# Orígenes permitidos para CORS (frontend). Una URL o varias separadas por coma.
#   CORS_ORIGIN=http://localhost:5173
#   CORS_ORIGIN=http://localhost:5173,https://miniproyecto2.vercel.app
CORS_ORIGIN=http://localhost:5173

# Secreto compartido entre el room-service (Repositorio 1) y este servicio.
# Firma los tickets de conexión y autentica las llamadas internas en ambos
# sentidos (header `X-Internal-Secret`). DEBE coincidir con el INTERNAL_SECRET
# del room-service.
INTERNAL_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# URL del room-service (Repositorio 1). El chat-service le delega la
# persistencia de mensajes (Tarea 6) en POST /internal/rooms/:id/messages.
# Si se deja vacío, los mensajes se difunden pero NO se guardan en el historial.
# En local: http://localhost:3000 — en producción, la URL del room-service en Render.
ROOM_SERVICE_URL=http://localhost:3000
