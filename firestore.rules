rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Reglas Firestore — Mini-proyecto 2 "Salón de Estudio Colaborativo"
// Sprint 1 — TS-01: Autenticación / perfiles
//
// ARQUITECTURA DE SEGURIDAD
// ──────────────────────────
// El backend usa Firebase Admin SDK, que bypasea estas reglas por completo.
// Toda la lógica de negocio (unicidad de username, formato, validación de
// provider, etc.) vive en la API REST y en el Admin SDK.
//
// Estas reglas son la RED DE SEGURIDAD: impiden que un cliente malicioso
// hable directamente con Firestore usando el SDK de cliente y se salte las
// validaciones del backend.
//
// POLÍTICA BASE
// ──────────────
//  • Todo acceso requiere un Firebase ID Token válido (request.auth != null).
//  • Solo el dueño del documento puede leer su propio perfil completo.
//    (Otros usuarios solo necesitan username/avatar/online, que el backend
//    expone vía endpoints; el cliente directo queda restringido.)
//  • Solo el dueño puede crear, editar y eliminar su propio documento.
//  • Los campos inmutables (uid, email, provider, createdAt) no pueden
//    cambiarse desde el cliente aunque sea el propio dueño.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────
    // users/{uid}
    // ─────────────────────────────────────────────────────────────────────
    match /users/{uid} {

      // ✅ SOLO EL DUEÑO puede leer su propio perfil completo desde el cliente.
      // Otros usuarios leen datos de presencia y perfil a través del backend
      // (Admin SDK), que no está sujeto a estas reglas.
      allow read: if request.auth != null && request.auth.uid == uid;

      // ✅ SOLO EL DUEÑO puede crear su propio documento.
      // Restricciones adicionales:
      //   - El campo uid del documento debe coincidir con el UID del token.
      //   - Todos los campos del esquema deben estar presentes.
      //   - provider solo acepta "password" o "google".
      //   - username debe ser string de 4-10 chars (la unicidad y profanidad
      //     se validan en el backend; esto es la red de seguridad mínima).
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && request.resource.data.keys().hasAll([
                         'uid', 'username', 'fullName', 'email',
                         'avatar', 'provider', 'createdAt', 'online'
                       ])
                    && request.resource.data.provider in ['password', 'google']
                    && request.resource.data.username is string
                    && request.resource.data.username.size() >= 4
                    && request.resource.data.username.size() <= 10;

      // ✅ SOLO EL DUEÑO puede actualizar su propio perfil.
      // Campos editables desde el cliente: username, fullName, avatar, online.
      // Campos INMUTABLES que el cliente NO puede cambiar:
      //   uid, email, provider, createdAt.
      // La validación de unicidad de username se hace en el backend; aquí
      // solo garantizamos que los campos inmutables no se alteren.
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.provider == resource.data.provider
                    && request.resource.data.createdAt == resource.data.createdAt;

      // ✅ SOLO EL DUEÑO puede eliminar su propio perfil.
      // En la práctica, la eliminación se hace desde el backend (Admin SDK)
      // que bypasea estas reglas. Esta regla permite que el flujo funcione
      // si algún día se migra a eliminación directa desde el cliente con
      // confirmación de reautenticación.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ─────────────────────────────────────────────────────────────────────
    // rooms/{roomId}
    //
    // POLÍTICA:
    //  • Cualquier usuario autenticado puede LEER una sala (para unirse
    //    por enlace o listar salas compartidas).
    //  • Solo usuarios autenticados pueden CREAR salas, y el campo
    //    `ownerId` debe coincidir con su UID (el backend valida esto, aquí
    //    es la red de seguridad para acceso directo desde el cliente).
    //  • Solo el DUEÑO (`ownerId == request.auth.uid`) puede ACTUALIZAR
    //    o ELIMINAR su propia sala.
    //    Los campos inmutables `roomId`, `ownerId` y `createdAt` no pueden
    //    cambiar después de la creación.
    //
    // NOTA: El backend (Admin SDK) bypasea estas reglas. Son la red de
    // seguridad para clientes que intentan escribir directamente en Firestore.
    // ─────────────────────────────────────────────────────────────────────
    match /rooms/{roomId} {

      // ✅ Cualquier usuario autenticado puede leer salas.
      allow read: if request.auth != null;

      // ✅ Cualquier usuario autenticado puede CREAR una sala,
      //    siempre que el ownerId del documento coincida con su UID
      //    y que los campos mínimos estén presentes.
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.roomId is string
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100;

      // ✅ Solo el DUEÑO puede actualizar su sala.
      //    Los campos `roomId`, `ownerId` y `createdAt` son inmutables.
      allow update: if request.auth != null
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.roomId == resource.data.roomId
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.createdAt == resource.data.createdAt;

      // ✅ Solo el DUEÑO puede eliminar su sala.
      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;

      // Mensajes de la sala — lectura para autenticados, escritura solo backend.
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // ─────────────────────────────────────────────────────────────────────
    // Denegación por defecto — cualquier colección no contemplada arriba
    // queda completamente bloqueada para el cliente.
    // ─────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
