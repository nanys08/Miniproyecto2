# Backend endpoints
VITE_API_BASE_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000
# Chat-service (Repositorio 2): servidor WebSocket de tiempo real (puerto 8081).
VITE_CHAT_URL=http://localhost:8081
# Signaling Server WebRTC (Repositorio 3): videollamadas, audio y compartir
# pantalla. Servicio independiente (puerto 8082 en local). En producción, la
# URL pública del servicio en Render.
VITE_WEBRTC_URL=http://localhost:8082

# ── WebRTC (video / audio / compartir pantalla) ─────────────────────────────
# Servidor TURN para atravesar NAT/firewalls cuando la conexión P2P directa
# falla. Si se dejan VACÍAS (o comentadas), el cliente usa el TURN por defecto
# (metered.ca) definido en webrtcService.ts (DEFAULT_TURN), con cobertura
# UDP/TCP/443/TLS. Solo define estas variables si quieres forzar OTRO TURN.
# VITE_TURN_URL=turn:standard.relay.metered.ca:80
# VITE_TURN_USERNAME=tu_username_metered
# VITE_TURN_CREDENTIAL=tu_credential_metered

# Firebase Web SDK
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
